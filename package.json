{
  "name": "rateeat-backend",
  "version": "1.0.0",
  "description": "This directory will serve as the main directory for the RateEat app's backend.",
  "main": "server.js",
  "engine": {
    "node": "18.13.0"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node ./src/server.ts",
    "migrate": "node -e \"require('dotenv').config(); var env = process.env.NODE_ENV || 'development'; require('child_process').execSync('sequelize db:migrate --env ' + env, { stdio: [0, 1, 2] });\"",
    "build": "rimraf ./dist && tsc -p .",
    "start": "node ./dist/server.js"
  },
  "author": "RateEat",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/secret-manager": "^5.0.1",
    "@google-cloud/storage": "^7.3.1",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.3",
    "@types/multer": "^1.4.8",
    "@types/passport": "^1.0.13",
    "@types/passport-local": "^1.0.36",
    "@types/pg": "^8.10.3",
    "@types/sequelize": "^4.28.16",
    "axios": "^1.6.0",
    "cloudinary": "^1.41.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "datauri": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.1",
    "otp-generator": "^4.0.1",
    "passport": "^0.6.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-google-oidc": "^0.1.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "sequelize": "^6.33.0",
    "sequelize-cli": "^6.6.1",
    "sequelize-typescript": "^2.1.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/cookie-parser": "^1.4.4",
    "@types/cors": "^2.8.15",
    "@types/debug": "^4.1.9",
    "@types/otp-generator": "^4.0.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.0.1"
  }
}
